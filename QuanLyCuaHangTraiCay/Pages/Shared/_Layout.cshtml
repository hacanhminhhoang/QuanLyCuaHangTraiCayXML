@{
    string duongDan = Context.Request.Path.Value + Context.Request.QueryString;
    bool daDangNhap = User.Identity.IsAuthenticated;
    string Active(string url) => (url == "/" ? Context.Request.Path.Value == "/" : duongDan.StartsWith(url, StringComparison.OrdinalIgnoreCase)) ? "active" : null;
}
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] · Cửa hàng trái cây</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="alternate" type="application/rss+xml" title="Fruit Store – Bảng giá trái cây" href="/Rss" />
</head>
<body class="@(daDangNhap ? "co-menu" : "khong-menu")">
@if (daDangNhap)
{
    <aside class="sidebar">
        <a class="logo" href="/">
            <span class="logo-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22"><circle cx="12" cy="14" r="7" fill="#ffb74d"/><path d="M12 7c0-2.5 1.5-4 4-4-.2 2.6-1.6 4-4 4z" fill="#81c784"/></svg>
            </span>
            <span><b>Fruit Store</b><small>Quản lý cửa hàng trái cây</small></span>
        </a>
        <nav aria-label="Menu chính">
            <a class="@Active("/")" href="/">Tổng quan</a>
            <p class="nhom">Bán hàng</p>
            <a class="@Active("/LapHoaDon")" href="/LapHoaDon">Lập hóa đơn</a>
            <a class="@Active("/HoaDon")" href="/HoaDon">Hóa đơn &amp; doanh thu</a>
            <p class="nhom">Kho</p>
            <a class="@Active("/NhapHang")" href="/NhapHang">Nhập hàng</a>
            <a class="@Active("/PhieuNhap")" href="/PhieuNhap">Phiếu nhập</a>
            <p class="nhom">Danh mục</p>
            <a class="@Active("/DanhMuc/TraiCay")" href="/DanhMuc/TraiCay">Trái cây</a>
            <a class="@Active("/DanhMuc/NhaCungCap")" href="/DanhMuc/NhaCungCap">Nhà cung cấp</a>
            <a class="@Active("/DanhMuc/KhachHang")" href="/DanhMuc/KhachHang">Khách hàng</a>
            @if (User.LaAdmin())
            {
                <a class="@Active("/DanhMuc/NhanVien")" href="/DanhMuc/NhanVien">Nhân viên</a>
                <a class="@Active("/DanhMuc/TaiKhoan")" href="/DanhMuc/TaiKhoan">Tài khoản</a>
                <p class="nhom">Hệ thống</p>
                <a class="@Active("/DuLieu")" href="/DuLieu">Dữ liệu XML</a>
            }
        </nav>
        <div class="nguoi-dung">
            <span class="avatar" aria-hidden="true">@User.HoTen()?.Split(' ').Last().Substring(0, 1)</span>
            <span class="ten"><b>@User.HoTen()</b><small>@(User.LaAdmin() ? "Quản lý" : "Nhân viên")</small></span>
            <a href="/Rss" class="lien-ket-nho" target="_blank" rel="noopener">RSS bảng giá</a>
            <a href="/DoiMatKhau" class="lien-ket-nho">Đổi mật khẩu</a>
            <form method="post" asp-page="/DangXuat"><button class="lien-ket-nho" type="submit">Đăng xuất</button></form>
        </div>
    </aside>
}
    <main class="noi-dung">
        @if (TempData["ThongBao"] != null)
        {
            <div class="alert alert-ok" role="status">
                @TempData["ThongBao"]
                @if (TempData["InHoaDon"] != null)
                {
                    <a href="/Xslt?bang=HoaDon&amp;xslt=HoaDon&amp;maHD=@TempData["InHoaDon"]" target="_blank">In hóa đơn</a>
                }
            </div>
        }
        @if (TempData["Loi"] != null)
        {
            <div class="alert alert-loi" role="alert">@TempData["Loi"]</div>
        }
        @RenderBody()
    </main>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
