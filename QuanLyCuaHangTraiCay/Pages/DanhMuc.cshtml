@page "{bang=TraiCay}"
@model DanhMucModel
@{
    var ch = Model.CauHinh;
    ViewData["Title"] = ch.TieuDe;
    string khoa = ch.Cot[0].Ten;
}
<header class="tieu-de-trang">
    <div>
        <h1>@ch.TieuDe</h1>
        <p class="phu">Dữ liệu lưu tại <code>Data/@(Model.Bang).xml</code>, kiểm tra theo <code>@(Model.Bang).xsd</code> mỗi lần lưu.</p>
    </div>
    <a class="nut" href="/Xslt?bang=@Model.Bang&amp;tuKhoa=@Model.TuKhoa" target="_blank" rel="noopener"><svg class="ic" aria-hidden="true"><use href="#ic-code" /></svg>Xem bằng XSLT<svg class="ic ic-sm" aria-hidden="true"><use href="#ic-external" /></svg><span class="sr-only"> (mở tab mới)</span></a>
</header>

<div>
    <form method="post" asp-page-handler="Luu" class="the form-nhap" id="form-nhap" aria-labelledby="tieu-de-form">
        <h2 id="tieu-de-form">@(Model.DangSua ? "Sửa " + ch.TieuDe.ToLower() : "Thêm " + ch.TieuDe.ToLower())</h2>
        @if (Model.Loi != null)
        {
            <div class="alert alert-loi" role="alert" id="tom-tat-loi" tabindex="-1">
                <svg class="ic" aria-hidden="true"><use href="#ic-error" /></svg>
                <div>
                    @Model.Loi
                    @if (Model.TruongLoi != null)
                    {
                        <a href="#o-@Model.TruongLoi">Đến ô cần sửa</a>
                    }
                    @if (Model.ChiTietLoi != null)
                    {
                        <details><summary>Chi tiết kỹ thuật</summary><pre>@Model.ChiTietLoi</pre></details>
                    }
                </div>
            </div>
        }
        <input type="hidden" name="dangSua" value="@Model.DangSua.ToString().ToLower()" />
        <div class="cac-truong">
        @for (int i = 0; i < ch.Cot.Length; i++)
        {
            var c = ch.Cot[i];
            string gt = Model.GiaTri.GetValueOrDefault(c.Ten, "");
            bool chiDoc = i == 0 && (Model.DangSua || ch.TienTo != null);
            bool loi = c.Ten == Model.TruongLoi;
            bool batBuoc = i < 2 && !(c.Kieu == "password" && Model.DangSua);
            string moTa = loi ? "loi-" + c.Ten : null;
            @:<div>
            <label for="o-@c.Ten">@c.NhanDe@if (batBuoc) {<span class="dau-sao" aria-hidden="true">*</span>}</label>
            if (c.LuaChon != null || c.BangLienKet != null)
            {
                var ds = c.LuaChon != null ? c.LuaChon.ToDictionary(x => x, x => x) : Model.LienKet[c.Ten];
                <select id="o-@c.Ten" name="@c.Ten" class="@(loi ? "o-loi" : null)" aria-invalid="@(loi ? "true" : null)" aria-describedby="@moTa">
                    @foreach (var lc in ds)
                    {
                        <option value="@lc.Key" selected="@(lc.Key == gt)">@lc.Value</option>
                    }
                </select>
            }
            else
            {
                <input id="o-@c.Ten" name="@c.Ten" value="@(c.Kieu == "password" ? "" : gt)" type="@c.Kieu" readonly="@chiDoc" class="@(loi ? "o-loi" : null)" aria-invalid="@(loi ? "true" : null)" aria-describedby="@moTa"
                       autocomplete="@(c.Kieu == "password" ? "new-password" : null)" placeholder="@(c.Kieu == "password" && Model.DangSua ? "Để trống = giữ nguyên" : null)"
                       required="@batBuoc" min="@(c.Kieu == "number" ? "0" : null)" step="@(c.Kieu == "number" ? "1" : null)" />
            }
            if (loi)
            {
                <p class="loi-o" id="loi-@c.Ten"><svg class="ic ic-sm" aria-hidden="true"><use href="#ic-error" /></svg><span>@Model.GoiYLoi</span></p>
            }
            @:</div>
        }
        </div>
        <p class="ghi-chu-bat-buoc"><span class="dau-sao" aria-hidden="true">*</span> Bắt buộc nhập</p>
        <div class="hang-nut">
            <button class="nut nut-chinh" type="submit"><svg class="ic" aria-hidden="true"><use href="@(Model.DangSua ? "#ic-edit" : "#ic-plus")" /></svg>@(Model.DangSua ? "Lưu thay đổi" : "Thêm mới")</button>
            @if (Model.DangSua)
            {
                <a class="nut" href="/DanhMuc/@Model.Bang">Hủy</a>
            }
        </div>
    </form>

    <section class="the" aria-labelledby="tieu-de-bang">
        <h2 class="sr-only" id="tieu-de-bang">Danh sách @ch.TieuDe.ToLower()</h2>
        <form method="get" class="thanh-tim" role="search">
            <input name="tuKhoa" type="search" value="@Model.TuKhoa" placeholder="Tìm theo bất kỳ thông tin nào…" aria-label="Từ khóa tìm kiếm" />
            <button class="nut" type="submit"><svg class="ic" aria-hidden="true"><use href="#ic-search" /></svg>Tìm</button>
            @if (!string.IsNullOrEmpty(Model.TuKhoa))
            {
                <a class="nut nut-nhe" href="/DanhMuc/@Model.Bang"><svg class="ic" aria-hidden="true"><use href="#ic-close" /></svg>Bỏ lọc</a>
            }
        </form>
        <p class="phu" role="status">Hiển thị @Model.DuLieu.Rows.Count / @Model.TongSo dòng</p>
        <div class="cuon-ngang">
            <table class="bang">
                <caption class="sr-only">Danh sách @ch.TieuDe.ToLower(), @Model.DuLieu.Rows.Count dòng</caption>
                <thead>
                    <tr>
                        @foreach (var c in ch.Cot)
                        {
                            <th scope="col" class="@(c.Kieu == "number" ? "so" : null)">@c.NhanDe</th>
                        }
                        <th scope="col"><span class="sr-only">Thao tác</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (DataRow r in Model.DuLieu.Rows)
                    {
                        string ma = r[khoa].ToString();
                        <tr class="@(ma == Model.Ma ? "dang-chon" : null)" aria-current="@(ma == Model.Ma ? "true" : null)">
                            @foreach (var c in ch.Cot)
                            {
                                object v = r[c.Ten];
                                if (c.Ten == "SoLuongTon")
                                {
                                    int ton = Convert.ToInt32(v);
                                    <td class="so"><partial name="_TonKho" model="ton" /></td>
                                }
                                else if (c.Kieu == "number") { <td class="so">@DinhDang.So(v)</td> }
                                else if (c.Kieu == "date") { <td>@DinhDang.Ngay(v)</td> }
                                else if (c.Ten == "MatKhau") { <td><span aria-label="đã ẩn">••••••</span></td> }
                                else if (c.BangLienKet != null) { <td>@Model.LienKet[c.Ten].Ten(v)</td> }
                                else { <td>@v</td> }
                            }
                            <td class="thao-tac">
                                <a href="/DanhMuc/@Model.Bang?ma=@ma"><svg class="ic ic-sm" aria-hidden="true"><use href="#ic-edit" /></svg>Sửa<span class="sr-only"> @ma</span></a>
                                <form method="post" asp-page-handler="Xoa" onsubmit="return confirm('Xóa @ma?')">
                                    <input type="hidden" name="maXoa" value="@ma" />
                                    <button type="submit" class="lien-ket-xoa"><svg class="ic ic-sm" aria-hidden="true"><use href="#ic-trash" /></svg>Xóa<span class="sr-only"> @ma</span></button>
                                </form>
                            </td>
                        </tr>
                    }
                    @if (Model.DuLieu.Rows.Count == 0)
                    {
                        <tr><td colspan="@(ch.Cot.Length + 1)" class="trong">
                            <svg class="ic" aria-hidden="true"><use href="#ic-search" /></svg>
                            @if (!string.IsNullOrEmpty(Model.TuKhoa)) { <text>Không tìm thấy kết quả cho “@Model.TuKhoa”. <a href="/DanhMuc/@Model.Bang">Bỏ lọc</a></text> }
                            else { <text>Chưa có dữ liệu. Nhập thông tin ở biểu mẫu phía trên để thêm dòng đầu tiên.</text> }
                        </td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
</div>

@section Scripts {
    @if (Model.Loi != null)
    {
        <script>document.getElementById('tom-tat-loi').focus();</script>
    }
}
