@page
@model PhieuNhapModel
@{ ViewData["Title"] = "Phiếu nhập"; }
<header class="tieu-de-trang">
    <div>
        <h1>Phiếu nhập hàng</h1>
        <p class="phu">@Model.DanhSach.Count phiếu · tổng tiền nhập <b>@DinhDang.Tien(Model.TongNhap)</b></p>
    </div>
    <a class="nut nut-chinh" href="/NhapHang"><svg class="ic" aria-hidden="true"><use href="#ic-plus" /></svg>Nhập hàng</a>
</header>

<form method="get" class="the thanh-loc">
    <label>Từ ngày <input type="date" name="tu" value="@Model.Tu?.ToString("yyyy-MM-dd")" /></label>
    <label>Đến ngày <input type="date" name="den" value="@Model.Den?.ToString("yyyy-MM-dd")" /></label>
    <button class="nut" type="submit"><svg class="ic" aria-hidden="true"><use href="#ic-filter" /></svg>Lọc</button>
    <a class="nut nut-nhe" href="/PhieuNhap">Tất cả</a>
</form>

<div class="luoi-hai-cot rong-trai">
    <section class="the">
        <div class="cuon-ngang">
            <table class="bang">
                <caption class="sr-only">Danh sách phiếu nhập</caption>
                <thead><tr><th scope="col">Mã PN</th><th scope="col">Ngày nhập</th><th scope="col">Nhà cung cấp</th><th scope="col">Nhân viên</th><th scope="col" class="so">Tổng tiền</th></tr></thead>
                <tbody>
                    @foreach (var r in Model.DanhSach)
                    {
                        string ma = r["MaPN"].ToString();
                        <tr class="@(r == Model.DangChon ? "dang-chon" : null)">
                            <td><a href="/PhieuNhap?ma=@ma&amp;tu=@Model.Tu?.ToString("yyyy-MM-dd")&amp;den=@Model.Den?.ToString("yyyy-MM-dd")">@ma</a></td>
                            <td>@DinhDang.Ngay(r["NgayNhap"])</td>
                            <td>@Model.TenNCC.Ten(r["MaNCC"])</td>
                            <td>@Model.TenNhanVien.Ten(r["MaNV"])</td>
                            <td class="so">@DinhDang.Tien(r["TongTien"])</td>
                        </tr>
                    }
                    @if (Model.DanhSach.Count == 0)
                    {
                        <tr><td colspan="5" class="trong"><svg class="ic" aria-hidden="true"><use href="#ic-clipboard" /></svg>Không có phiếu nhập trong khoảng thời gian này.</td></tr>
                    }
                </tbody>
            </table>
        </div>
    </section>

    @if (Model.DangChon != null)
    {
        var pn = Model.DangChon;
        <section class="the chi-tiet">
            <div class="the-dau">
                <h2>Phiếu @pn["MaPN"]</h2>
                <span class="phu">@DinhDang.Ngay(pn["NgayNhap"])</span>
            </div>
            <dl class="thong-tin">
                <dt>Nhà cung cấp</dt><dd>@Model.TenNCC.Ten(pn["MaNCC"])</dd>
                <dt>Nhân viên</dt><dd>@Model.TenNhanVien.Ten(pn["MaNV"])</dd>
            </dl>
            <div class="cuon-ngang">
                <table class="bang">
                    <caption class="sr-only">Chi tiết phiếu nhập @pn["MaPN"]</caption>
                    <thead><tr><th scope="col">Trái cây</th><th scope="col" class="so">SL</th><th scope="col" class="so">Đơn giá nhập</th><th scope="col" class="so">Thành tiền</th></tr></thead>
                    <tbody>
                        @foreach (var c in Model.ChiTiet)
                        {
                            <tr>
                                <td>@Model.TenTraiCay.Ten(c["MaTC"])</td>
                                <td class="so">@c["SoLuong"]</td>
                                <td class="so">@DinhDang.So(c["DonGiaNhap"])</td>
                                <td class="so">@DinhDang.So(c["ThanhTien"])</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot><tr><th scope="row" colspan="3">Tổng tiền</th><th class="so">@DinhDang.Tien(pn["TongTien"])</th></tr></tfoot>
                </table>
            </div>
            @if (User.LaAdmin())
            {
                <div class="hang-nut">
                    <form method="post" asp-page-handler="Xoa" onsubmit="return confirm('Xóa phiếu nhập @pn["MaPN"] và trừ lại tồn kho?')">
                        <input type="hidden" name="maXoa" value="@pn["MaPN"]" />
                        <button class="nut nut-nguy-hiem" type="submit"><svg class="ic" aria-hidden="true"><use href="#ic-trash" /></svg>Xóa phiếu nhập</button>
                    </form>
                </div>
            }
        </section>
    }
</div>
