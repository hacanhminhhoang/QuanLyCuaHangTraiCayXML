<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>QuanLyCuaHangTraiCay</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.SqlClient" Version="5.2.2" />
  </ItemGroup>

  <!-- Thư mục Data (XML, XSD, XSLT) được đọc/ghi trực tiếp tại thư mục project; chép kèm khi publish -->
  <ItemGroup>
    <None Update="Data\**" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
