<?xml version="1.0" encoding="utf-8"?>
<!-- Lược đồ XSD cho file PhieuNhap.xml -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:element name="NewDataSet">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="PhieuNhap" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="MaPN">
                <xs:annotation><xs:documentation>Mã phiếu nhập</xs:documentation></xs:annotation>
                <xs:simpleType><xs:restriction base="xs:string"><xs:pattern value="PN[0-9]{3}"/></xs:restriction></xs:simpleType>
              </xs:element>
              <xs:element name="NgayNhap" type="xs:date"><xs:annotation><xs:documentation>Ngày nhập</xs:documentation></xs:annotation></xs:element>
              <xs:element name="MaNV">
                <xs:annotation><xs:documentation>Nhân viên lập phiếu</xs:documentation></xs:annotation>
                <xs:simpleType><xs:restriction base="xs:string"><xs:pattern value="NV[0-9]{3}"/></xs:restriction></xs:simpleType>
              </xs:element>
              <xs:element name="MaNCC">
                <xs:annotation><xs:documentation>Nhà cung cấp</xs:documentation></xs:annotation>
                <xs:simpleType><xs:restriction base="xs:string"><xs:pattern value="NCC[0-9]{3}"/></xs:restriction></xs:simpleType>
              </xs:element>
              <xs:element name="TongTien">
                <xs:annotation><xs:documentation>Tổng tiền nhập</xs:documentation></xs:annotation>
                <xs:simpleType><xs:restriction base="xs:decimal"><xs:minInclusive value="0"/><xs:fractionDigits value="0"/><xs:pattern value="[0-9]+"/></xs:restriction></xs:simpleType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
    <!-- Khóa chính: không cho phép trùng -->
    <xs:key name="PK_PhieuNhap">
      <xs:selector xpath="PhieuNhap"/>
      <xs:field xpath="MaPN"/>
    </xs:key>
  </xs:element>
</xs:schema>
