<?xml version="1.0" encoding="utf-8"?>
<!-- Lược đồ XSD cho file NhanVien.xml -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:element name="NewDataSet">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="NhanVien" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="MaNV">
                <xs:annotation><xs:documentation>Mã nhân viên: NV + 3 chữ số</xs:documentation></xs:annotation>
                <xs:simpleType><xs:restriction base="xs:string"><xs:pattern value="NV[0-9]{3}"/></xs:restriction></xs:simpleType>
              </xs:element>
              <xs:element name="HoTen">
                <xs:annotation><xs:documentation>Họ tên</xs:documentation></xs:annotation>
                <xs:simpleType><xs:restriction base="xs:string"><xs:minLength value="1"/><xs:maxLength value="100"/></xs:restriction></xs:simpleType>
              </xs:element>
              <xs:element name="GioiTinh">
                <xs:annotation><xs:documentation>Giới tính</xs:documentation></xs:annotation>
                <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="Nam"/><xs:enumeration value="Nữ"/></xs:restriction></xs:simpleType>
              </xs:element>
              <xs:element name="NgaySinh" type="xs:date"><xs:annotation><xs:documentation>Ngày sinh yyyy-MM-dd</xs:documentation></xs:annotation></xs:element>
              <xs:element name="DiaChi">
                <xs:annotation><xs:documentation>Địa chỉ</xs:documentation></xs:annotation>
                <xs:simpleType><xs:restriction base="xs:string"><xs:minLength value="1"/><xs:maxLength value="150"/></xs:restriction></xs:simpleType>
              </xs:element>
              <xs:element name="SDT">
                <xs:annotation><xs:documentation>Số điện thoại 10 số</xs:documentation></xs:annotation>
                <xs:simpleType><xs:restriction base="xs:string"><xs:pattern value="0[0-9]{9}"/></xs:restriction></xs:simpleType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
    <!-- Khóa chính: không cho phép trùng -->
    <xs:key name="PK_NhanVien">
      <xs:selector xpath="NhanVien"/>
      <xs:field xpath="MaNV"/>
    </xs:key>
  </xs:element>
</xs:schema>
