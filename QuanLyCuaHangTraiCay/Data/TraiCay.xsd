<?xml version="1.0" encoding="utf-8"?>
<!-- Lược đồ XSD cho file TraiCay.xml -->
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema" elementFormDefault="qualified">
  <xs:element name="NewDataSet">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="TraiCay" minOccurs="0" maxOccurs="unbounded">
          <xs:complexType>
            <xs:sequence>
              <xs:element name="MaTC">
                <xs:annotation><xs:documentation>Mã trái cây</xs:documentation></xs:annotation>
                <xs:simpleType><xs:restriction base="xs:string"><xs:pattern value="TC[0-9]{3}"/></xs:restriction></xs:simpleType>
              </xs:element>
              <xs:element name="TenTC">
                <xs:annotation><xs:documentation>Tên trái cây</xs:documentation></xs:annotation>
                <xs:simpleType><xs:restriction base="xs:string"><xs:minLength value="1"/><xs:maxLength value="100"/></xs:restriction></xs:simpleType>
              </xs:element>
              <xs:element name="XuatXu">
                <xs:annotation><xs:documentation>Xuất xứ</xs:documentation></xs:annotation>
                <xs:simpleType><xs:restriction base="xs:string"><xs:minLength value="1"/><xs:maxLength value="100"/></xs:restriction></xs:simpleType>
              </xs:element>
              <xs:element name="DonViTinh">
                <xs:annotation><xs:documentation>Đơn vị tính</xs:documentation></xs:annotation>
                <xs:simpleType><xs:restriction base="xs:string"><xs:minLength value="1"/><xs:maxLength value="20"/></xs:restriction></xs:simpleType>
              </xs:element>
              <xs:element name="DonGia">
                <xs:annotation><xs:documentation>Đơn giá (VNĐ)</xs:documentation></xs:annotation>
                <xs:simpleType><xs:restriction base="xs:decimal"><xs:minInclusive value="0"/><xs:fractionDigits value="0"/><xs:pattern value="[0-9]+"/></xs:restriction></xs:simpleType>
              </xs:element>
              <xs:element name="SoLuongTon">
                <xs:annotation><xs:documentation>Số lượng tồn kho</xs:documentation></xs:annotation>
                <xs:simpleType><xs:restriction base="xs:int"><xs:minInclusive value="0"/></xs:restriction></xs:simpleType>
              </xs:element>
              <xs:element name="MaNCC">
                <xs:annotation><xs:documentation>Nhà cung cấp</xs:documentation></xs:annotation>
                <xs:simpleType><xs:restriction base="xs:string"><xs:pattern value="NCC[0-9]{3}"/></xs:restriction></xs:simpleType>
              </xs:element>
            </xs:sequence>
          </xs:complexType>
        </xs:element>
      </xs:sequence>
    </xs:complexType>
    <!-- Khóa chính: không cho phép trùng -->
    <xs:key name="PK_TraiCay">
      <xs:selector xpath="TraiCay"/>
      <xs:field xpath="MaTC"/>
    </xs:key>
  </xs:element>
</xs:schema>
